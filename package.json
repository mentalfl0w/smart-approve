{
  "name": "smart-approve",
  "description": "High-risk-only approval hook with LLM risk analysis, behavior detection, protected-path interception, and decision memory for oh-my-pi (OMP) and pi-agent.",
  "version": "2.7.1",
  "files": [
    "dist"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "omp-extension",
    "pi",
    "pi-agent",
    "pi-package",
    "pi-extension",
    "safety",
    "approval",
    "bash",
    "hook"
  ],
  "license": "MIT",
  "author": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --outdir dist --target bun --external @oh-my-pi/pi-ai",
    "dev": "bun run src/index.ts",
    "test": "bun test src"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.10.1",
    "@oh-my-pi/pi-catalog": "18.10.1",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=18.10.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    }
  }
}
